{
  "version": 2,
  "rewrites": [
    { "source": "/add/:slug", "destination": "/api/event?slug=:slug" },
    { "source": "/go/:slug", "destination": "/api/go?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/api/event",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" }
      ]
    }
  ]
}
